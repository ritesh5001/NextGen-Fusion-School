# Postgres connection (used by Drizzle + server functions)
DATABASE_URL=postgres://sms:sms@localhost:5432/sms

# JWT signing (generate a 64+ char random string for prod)
JWT_ACCESS_SECRET=change-me-access-secret-please-rotate-in-production-64chars
JWT_REFRESH_SECRET=change-me-refresh-secret-please-rotate-in-production-64chars
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=1209600     # 14 days

# Optional: default super admin bootstrapped by the seed script
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=admin12345

# Public app URL (used for password reset emails, etc.)
APP_URL=http://localhost:8080
