# Replace yourdomain.edu with the school's actual domain before deploying.
# Caddy automatically provisions HTTPS via Let's Encrypt.

yourdomain.edu {
  encode gzip
  reverse_proxy localhost:8080

  header {
    # HTTPS enforcement (2 years, include subdomains)
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    # Clickjacking / MIME-sniffing / referrer / permissions hardening
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Conservative CSP. Loosen connect-src/img-src if you add CDNs.
    Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.resend.com https://upload.imagekit.io https://ik.imagekit.io; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    # Don't leak the server banner
    -Server
  }
}

www.yourdomain.edu {
  redir https://yourdomain.edu{uri}
}
